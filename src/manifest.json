{
  "manifest_version": 3,
  "name": "BrowseGoal",
  "version": "1.2.7",

  "description": "Set a goal when visiting distracting sites to keep focused.",

  "icons": {
    "48": "icons/icon-48.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["browser-polyfill.min.js", "main.js"]
    }
  ],
  "options_ui": {
    "page": "options/options.html"
  },

  "action": {
    "default_icon": {
      "32": "icons/icon-48.png"
    },
    "default_title": "BrowseGoal",
    "default_popup": "options/options.html"
  },

  "permissions": ["storage"]
}
